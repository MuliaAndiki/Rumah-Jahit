generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")

}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("users") 
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  slug         String        @unique @db.VarChar(120)
  catalogItems CatalogItem[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@map("categories")
}

model CatalogItem {
  id            String         @id @default(uuid()) @db.Uuid
  categoryId    Int?           @map("category_id")
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title         String         @db.VarChar(200)
  slug          String         @unique @db.VarChar(220)
  description   String?        @db.Text
  priceStart    Decimal?       @map("price_start") @db.Decimal(12, 0) 
  estimatedTime String?        @map("estimated_time") @db.VarChar(50) 
  isFeatured    Boolean        @default(false) @map("is_featured") 
  isPublished   Boolean        @default(true) @map("is_published") 
  images        CatalogImage[] 
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([categoryId])
  @@index([isPublished, isFeatured])
  @@map("catalog_items")
}

model CatalogImage {
  id                 String      @id @default(uuid()) @db.Uuid
  catalogItemId      String      @map("catalog_item_id") @db.Uuid
  catalogItem        CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  imageUrl           String      @map("image_url") @db.VarChar(500) 
  cloudinaryPublicId String      @map("cloudinary_public_id") @db.VarChar(255)
  isPrimary          Boolean     @default(false) @map("is_primary") 
  displayOrder       Int         @default(0) @map("display_order") 
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([catalogItemId])
  @@map("catalog_images")
}